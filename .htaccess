PassengerAppRoot "/home/mainla12/backend.mainlandsolar.com"
PassengerBaseURI "/"
PassengerNodejs "/home/mainla12/nodevenv/backend.mainlandsolar.com/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
