# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

# -----------------------------------------------------------------------
# Cache bypass — Mainland Solar Node.js API
#
# This entire domain (backend.mainlandsolar.com) is a REST API served
# via Passenger. No response should ever be cached by LiteSpeed or any
# proxy layer sitting in front of it.
# -----------------------------------------------------------------------

# LiteSpeed native cache bypass.
# RewriteRule with E=no-cache:1 sets the internal LiteSpeed flag that
# prevents the page cache from storing or serving the response.
# CacheEnable off / disables the LiteSpeed built-in cache for all paths.
<IfModule Litespeed>
    RewriteEngine On
    RewriteRule .* - [E=no-cache:1,L]
    CacheEnable off /
</IfModule>

# Apache mod_headers fallback (also read by LiteSpeed in Apache-compat mode).
# "always" ensures the headers are set even on error/redirect responses.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Surrogate-Control "no-store"
    Header always set X-LiteSpeed-Cache-Control "no-cache"
    Header always set Vary "*"
</IfModule>

# Apache mod_cache bypass (belt-and-suspenders).
<IfModule mod_cache.c>
    CacheDisable On
</IfModule>
